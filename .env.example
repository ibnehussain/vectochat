# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Chat completions endpoint, e.g.:
#   https://<hub>.services.ai.azure.com/models
AZURE_FOUNDRY_ENDPOINT=https://<your-hub>.services.ai.azure.com/models
AZURE_FOUNDRY_KEY=<your-foundry-api-key>
AZURE_FOUNDRY_CHAT_MODEL=gpt-4o              # deployment name for chat
AZURE_FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small  # deployment name for embeddings

# ── Azure Cosmos DB ───────────────────────────────────────────────────────────
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_KEY=<your-cosmos-primary-key>
COSMOS_DATABASE=chatbot_db
COSMOS_DOCS_CONTAINER=documents
COSMOS_CONV_CONTAINER=conversations

# ── Azure Cache for Redis ─────────────────────────────────────────────────────
# Hostname: <cache-name>.redis.cache.windows.net
REDIS_HOST=<your-cache>.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=<your-redis-access-key>
REDIS_TLS=true

# ── RAG tuning ────────────────────────────────────────────────────────────────
TOP_K=5                    # number of document chunks returned by vector search
MAX_HISTORY=20             # max conversation turns kept in context
EMBEDDING_CACHE_TTL=86400  # seconds — 24 hours
HISTORY_CACHE_TTL=3600     # seconds — 1 hour
