# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Chat completions endpoint, e.g.:
#   https://<hub>.services.ai.azure.com/models
AZURE_FOUNDRY_ENDPOINT=https://<hub>.services.ai.azure.com/openai/v1/responses
AZURE_FOUNDRY_KEY=Key
AZURE_FOUNDRY_CHAT_MODEL=gpt-5.4             # deployment name for chat
AZURE_FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small # deployment name for embeddings

# ── Azure Cosmos DB ───────────────────────────────────────────────────────────
COSMOS_ENDPOINT=https://mychatcosmos.documents.azure.com:443/
COSMOS_KEY=<your-cosmos-primary-key>
COSMOS_DATABASE=chatbot
COSMOS_DOCS_CONTAINER=documents
COSMOS_CONV_CONTAINER=conversations

# ── Azure Managed Redis ──────────────────────────────────────────────────────
# Hostname format: <cluster-name>.<region>.redisenterprise.cache.azure.net
# SKU: Balanced_B0 (0.5 GB) — port 10000 (TLS)
REDIS_HOST=<cluster-name>.<region>.redisenterprise.cache.azure.net
REDIS_PORT=10000
REDIS_PASSWORD=<your-redis-primary-key>
REDIS_TLS=true

# ── RAG tuning ────────────────────────────────────────────────────────────────
TOP_K=5                    # number of document chunks returned by vector search
MAX_HISTORY=20             # max conversation turns kept in context
EMBEDDING_CACHE_TTL=86400  # seconds — 24 hours
HISTORY_CACHE_TTL=3600     # seconds — 1 hour
ENABLE_DOCS=false